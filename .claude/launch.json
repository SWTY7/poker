{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "poker-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "poker-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "preview", "--port", "4173", "--strictPort"],
      "port": 4173,
      "autoPort": false
    },
    {
      "name": "rooms-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "server:dev"],
      "port": 8787,
      "autoPort": false
    }
  ]
}
